---
import BaseLayout from "../../layouts/BaseLayout.astro"; import {getCollection} from "astro:content";
const bs=await getCollection("blogs"); const cats=["ALL","BIS","BEE","WPC","EPR","MTCTE","TEC"];
---<BaseLayout title="Blogs | Jarulbee India"><section class="hero"><p class="eyebrow">Jarulbee Insights</p><h1>Regulatory knowledge, without the clutter.</h1></section><section class="section"><input class="search" id="search" placeholder="Search blogs..."/><div class="filters">{cats.map(c=><button class="filter" data-cat={c}>{c}</button>)}</div><div class="grid">{bs.map(b=><a class="card blog" data-cat={b.data.category} data-text={`${b.data.title} ${b.data.excerpt||""}`.toLowerCase()} href={`/blogs/${b.id}/`}><small>{b.data.category}</small><h3>{b.data.title}</h3><p>{b.data.excerpt}</p></a>)}</div></section><script>const cards=[...document.querySelectorAll(".blog")],btns=[...document.querySelectorAll(".filter")],s=document.querySelector("#search");let cat="ALL";function f(){let q=(s.value||"").toLowerCase();cards.forEach(x=>x.style.display=(cat==="ALL"||x.dataset.cat===cat)&&x.dataset.text.includes(q)?"":"none")}btns.forEach(b=>b.onclick=()=>{cat=b.dataset.cat;btns.forEach(x=>x.classList.remove("active"));b.classList.add("active");f()});btns[0].classList.add("active");s.oninput=f;</script></BaseLayout>