---
import {getCollection,render} from "astro:content"; import BlogLayout from "../../layouts/BlogLayout.astro";
export async function getStaticPaths(){const xs=await getCollection("blogs");return xs.map(item=>({params:{slug:item.id},props:{item}}));}
const {item}=Astro.props; const {Content}=await render(item);
---<BlogLayout title={item.data.seo_title||item.data.title} description={item.data.seo_description||item.data.excerpt}><p class="eyebrow">{item.data.category}</p><h1>{item.data.title}</h1><p>{item.data.excerpt}</p>{item.data.image&&<img src={item.data.image} alt={item.data.title}/>}<p><small>By {item.data.author} · {item.data.date.toLocaleDateString()}</small></p><Content/></BlogLayout>