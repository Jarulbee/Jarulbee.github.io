---
import {getCollection,render} from "astro:content"; import CertificationLayout from "../../layouts/CertificationLayout.astro";
export async function getStaticPaths(){const xs=await getCollection("certifications");return xs.map(item=>({params:{slug:item.id},props:{item}}));}
const {item}=Astro.props; const {Content}=await render(item); const msg=encodeURIComponent(item.data.whatsapp_message||`Hello Jarulbee India, I need help with ${item.data.short_name} certification.`);
---<CertificationLayout title={`${item.data.short_name} | Jarulbee India`} description={item.data.description}><p class="eyebrow">{item.data.short_name}</p><h1>{item.data.title}</h1><p>{item.data.description}</p><div class="grid"><div class="card"><strong>Authority</strong><p>{item.data.authority}</p></div><div class="card"><strong>Typical timeline</strong><p>{item.data.timeline||"Case dependent"}</p></div></div>{item.data.checklist?.length && <section><h2>Document Checklist</h2><ul>{item.data.checklist.map(x=><li>{x}</li>)}</ul></section>}<Content/><p><a class="button" href={`https://wa.me/919999999999?text=${msg}`} target="_blank">Discuss {item.data.short_name} on WhatsApp</a></p></CertificationLayout>