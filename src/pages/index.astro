---
import BaseLayout from "../layouts/BaseLayout.astro"; import {getCollection} from "astro:content";
const cs=await getCollection("certifications"); const bs=(await getCollection("blogs")).slice(0,3);
---<BaseLayout><section class="hero"><p class="eyebrow">Jarulbee India · Compliance Advocacy</p><h1>Navigate Indian regulatory approvals with confidence.</h1><p>End-to-end regulatory and certification support for global and domestic manufacturers entering the Indian market.</p><a class="button" href="/certifications/">Explore Certifications</a></section><section class="section"><p class="eyebrow">Core Services</p><h2>Regulatory pathways, clearly managed.</h2><div class="grid">{cs.map(c=><a class="card" href={`/certifications/${c.id}/`}><strong>{c.data.short_name}</strong><h3>{c.data.title}</h3><p>{c.data.description}</p></a>)}</div></section><section class="section"><p class="eyebrow">Latest Insights</p><div class="grid">{bs.map(b=><a class="card" href={`/blogs/${b.id}/`}><small>{b.data.category}</small><h3>{b.data.title}</h3><p>{b.data.excerpt}</p></a>)}</div></section></BaseLayout>